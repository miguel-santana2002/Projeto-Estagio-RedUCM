# Copia este ficheiro para ".env" antes do primeiro "docker compose up".
# Os valores por omissao ja funcionam para desenvolvimento local.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- Postgres ---
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Conta de demonstracao criada automaticamente na primeira migration ---
# Login com TOTP (Google Authenticator, etc.) - nao precisa de email/SMTP.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=ChangeMe123!

# --- Email (opcional) ---
# Por omissao os emails de OTP sao escritos na consola do container django.
# Para usar SMTP real, muda o backend e preenche as credenciais abaixo.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

OLLAMA_MODEL=qwen2.5-coder:3b